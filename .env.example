# Copy to .env. Nothing in this project ever logs the values it reads.

# Where the warehouse lives. The collector uses this one and holds INSERT only.
EMBARGO_DSN=postgresql://embargo_writer:writer@localhost:5432/embargo

# Owner connection. Used by migrations, and by nothing else.
EMBARGO_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/embargo

# Sent in the User-Agent on every request. This project polls a public API
# belonging to someone else; they are entitled to know who is calling and to be
# able to ask us to stop. Put a real address here before running anything that
# is not a one-off local test.
EMBARGO_CONTACT=https://github.com/Muhammad-Haris-3/Embargo

# Seconds between requests. Conservative on purpose: the history route is
# undocumented and publishes no rate limit.
EMBARGO_MIN_INTERVAL_S=0.35
EMBARGO_MAX_RETRIES=5
